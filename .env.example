APP_NAME=Esensi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Produksi: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Driver hash: Argon2id untuk password baru, tetap bisa verifikasi bcrypt lama.
HASH_DRIVER=argon2id_bcrypt
# Parameter Argon2id (memory dalam KiB). Turunkan bila RAM server terbatas.
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
# Rehash bcrypt lama menjadi Argon2id setelah login berhasil.
HASH_REHASH_ON_LOGIN=true

# Password awal akun pegawai saat ETL/go-live (admin tidak memakai ini).
# Pegawai wajib diminta mengganti password setelah diberi tahu di luar aplikasi.
PEGAWAI_DEFAULT_PASSWORD=123456

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi wajib true agar cookie hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Lokasi kantor untuk validasi presensi (lihat config/presensi.php).
# Hanya-baca di aplikasi: ubah nilai di sini, bukan lewat halaman admin.
# latitude/longitude = derajat desimal; radius = METER (25000 = 25 km).
# Default-nya longgar untuk development lokal — isi nilai kantor yang
# sebenarnya sebelum dipakai di produksi.
PRESENSI_LAT=-2.91380858459444
PRESENSI_LONG=104.69505610526285
PRESENSI_RADIUS=25000

# Kode shift yang tidak dihitung terlambat, dipisah koma (lihat issue #34).
# Data lama memakai JK03 untuk lembur/akhir pekan, sehingga keterlambatan
# shift itu tidak pernah masuk rekap. Kosongkan bila semua shift dihitung.
PRESENSI_KODE_JAM_KERJA_DIABAIKAN=JK03

# Zona waktu penilaian tanggal absensi ("hari ini"/"bulan ini"). Aplikasi
# sendiri berjalan pada UTC; pakai zona waktu kantor agar tidak salah hari.
PRESENSI_ZONA_WAKTU=Asia/Jakarta

# Identitas kantor untuk header laporan PDF/Excel.
PRESENSI_NAMA_KANTOR="Balai Laboratorium Kesehatan Masyarakat Palembang"
PRESENSI_ALAMAT_KANTOR="Jl. SMB II No. 55, KM. 11 Alang-alang Lebar, Palembang 30154"

VITE_APP_NAME="${APP_NAME}"
